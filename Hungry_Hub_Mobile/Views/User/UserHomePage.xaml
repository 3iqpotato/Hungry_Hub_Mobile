<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.User.UserHomePage"
             xmlns:viewModels="clr-namespace:Hungry_Hub_Mobile.ViewModels.User" 
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Title="Начало">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>

            <DataTemplate x:Key="RestaurantTemplate">
                <Frame Margin="10,5" Padding="10" CornerRadius="10" 
                       BorderColor="LightGray" BackgroundColor="White">
                    <Grid ColumnDefinitions="70,*,Auto" RowDefinitions="Auto,Auto">

                        <!-- Снимка -->
                        <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                               Source="{Binding Img}" WidthRequest="60" HeightRequest="60" 
                               Aspect="AspectFill"/>

                        <!-- Име -->
                        <Label Grid.Row="0" Grid.Column="1" 
                               Text="{Binding Name}" FontSize="15" FontAttributes="Bold" 
                               TextColor="#333333"
                               VerticalOptions="Center"/>

                        <!-- Адрес -->
                        <Label Grid.Row="1" Grid.Column="1" 
                               Text="{Binding Address}" FontSize="11" TextColor="#666666"
                               LineBreakMode="WordWrap" MaxLines="1"/>

                        <!-- Рейтинг -->
                        <Label Grid.Row="0" Grid.Column="2" 
                               Text="{Binding Rating, StringFormat='⭐ {0:F1}'}" 
                               FontSize="12" TextColor="#FFB800"
                               VerticalOptions="Center"
                               IsVisible="{Binding Rating, Converter={StaticResource IsNotNullConverter}}"/>

                        <!-- Гестур за избор -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:UserHomeViewModel}}, Path=SelectRestaurantCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                    </Grid>
                </Frame>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ГОРНА ЛЕНТА -->
        <Grid Grid.Row="0"
              Padding="15,10"
              BackgroundColor="#2196F3"
              ColumnDefinitions="*,Auto">

            <Label Grid.Column="0"
                   Text="Hungry Hub"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="Изход"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="5,0"/>
        </Grid>

        <!-- Списък с ресторанти -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Restaurants}"
                        ItemTemplate="{StaticResource RestaurantTemplate}"
                        VerticalOptions="FillAndExpand">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10" Padding="20"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="🍽️" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Няма налични ресторанти"
                           FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Моля, опитайте по-късно"
                           FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Грешка -->
        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="10"/>

        <!-- ДОЛНА НАВИГАЦИЯ -->
        <Grid Grid.Row="3" 
              BackgroundColor="#2196F3" 
              Padding="0,8"
              ColumnDefinitions="*,*,*,*">

            <!-- Начало -->
            <VerticalStackLayout Grid.Column="0" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="🏠" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Начало" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Количка -->
            <VerticalStackLayout Grid.Column="1" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="🛒" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Количка" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCartCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Поръчки -->
            <VerticalStackLayout Grid.Column="2" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="📦" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Поръчки" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrdersCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Профил -->
            <VerticalStackLayout Grid.Column="3" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="👤" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Профил" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>