<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.User.ProfilePage"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             Title="Моят профил">

    <ContentPage.Resources>
        <!-- <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>

             Конвертор за обратен булев (за скриване на индикатора) 
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary> -->
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Горна навигационна лента -->
        <Grid Grid.Row="0"
              Padding="10,5"
              BackgroundColor="#2196F3"
              ColumnDefinitions="Auto,*,Auto">

            <!-- Бутон Начало -->
            <Button Grid.Column="0"
                    Text="🏠 Начало"
                    Command="{Binding GoToHomeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="5,0"/>

            <!-- Заглавие -->
            <Label Grid.Column="1"
                   Text="Моят профил"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- Бутон Редакция -->
            <Button Grid.Column="2"
                    Text="✏️ Редакция"
                    Command="{Binding GoToEditCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="5,0"/>
        </Grid>

        <!-- Съдържание - профил информация -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Снимка на потребителя -->
                <Frame HeightRequest="120" 
                       WidthRequest="120" 
                       CornerRadius="60"
                       HorizontalOptions="Center"
                       BorderColor="LightGray"
                       Padding="0">
                    <Image Source="{Binding Profile.Img}"
                           Aspect="AspectFill"
                           HeightRequest="120"
                           WidthRequest="120"/>
                </Frame>

                <!-- Име -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Име"
                           FontSize="14"
                           TextColor="Gray"/>
                    <Label Text="{Binding Profile.Name}"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    <BoxView HeightRequest="1" 
                             Color="LightGray" 
                             Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <!-- Телефон -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Телефон"
                           FontSize="14"
                           TextColor="Gray"/>
                    <Label Text="{Binding Profile.PhoneNumber}"
                           FontSize="16"/>
                    <BoxView HeightRequest="1" 
                             Color="LightGray" 
                             Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <!-- Адрес -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Адрес"
                           FontSize="14"
                           TextColor="Gray"/>
                    <Label Text="{Binding Profile.Address}"
                           FontSize="16"/>
                    <BoxView HeightRequest="1" 
                             Color="LightGray" 
                             Margin="0,5,0,0"/>
                </VerticalStackLayout>

                <!-- Activity индикатор -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                  IsVisible="{Binding IsBusy}"/>

                <!-- Съобщение за грешка -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>