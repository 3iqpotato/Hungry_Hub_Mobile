<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.User.ProfilePage"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Title="Моят профил">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ГОРНА ЛЕНТА -->
        <Grid Grid.Row="0"
              Padding="15,10"
              BackgroundColor="#2196F3"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Hungry Hub"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1"
                    Text="✏️ Редакция"
                    Command="{Binding GoToEditCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="14"
                    Padding="5,0"/>
        </Grid>

        <!-- Съдържание -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">
                <Frame HeightRequest="120" WidthRequest="120" CornerRadius="60"
                       HorizontalOptions="Center" BorderColor="LightGray" Padding="0">
                    <Image Source="{Binding Profile.Img}" Aspect="AspectFill"
                           HeightRequest="120" WidthRequest="120"/>
                </Frame>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Име" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding Profile.Name}" FontSize="18" FontAttributes="Bold"/>
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5,0,0"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Телефон" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding Profile.PhoneNumber}" FontSize="16"/>
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5,0,0"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Адрес" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding Profile.Address}" FontSize="16"/>
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5,0,0"/>
                </VerticalStackLayout>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding ErrorMessage}" TextColor="Red"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ДОЛНА НАВИГАЦИЯ -->
        <Grid Grid.Row="2"
              BackgroundColor="#2196F3"
              Padding="0,8"
              ColumnDefinitions="*,*,*,*">
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Label Text="🏠" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Начало" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="🛒" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Количка" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCartCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Label Text="📦" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Поръчки" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrdersCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <Label Text="👤" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Профил" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>