<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.User.CompleteUserProfilePage"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource BackgroundGradient}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

                <!-- Бутон за назад - прост и надежден -->
                <Button Text="←"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="36"
                        FontAttributes="Bold"
                        WidthRequest="60"
                        HeightRequest="60"
                        HorizontalOptions="Start"
                        Margin="-10,-20,0,0"/>

                <!-- Лого/Иконка -->
                <Frame HeightRequest="100" 
                       WidthRequest="100" 
                       CornerRadius="50"
                       HorizontalOptions="Center"
                       BackgroundColor="White"
                       Padding="20"
                       Margin="0,0,0,20">
                    <Label Text="📝"
                           FontSize="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <Label Text="Завършете своя профил"
                       Style="{StaticResource TitleLabel}"
                       FontSize="28"/>

                <Label Text="Моля попълнете вашите данни"
                       Style="{StaticResource SubtitleLabel}"/>

                <!-- Форма за попълване -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       Padding="20"
                       Margin="0,15">
                    <VerticalStackLayout Spacing="15">

                        <!-- Profile Image -->
                        <Frame HeightRequest="100" 
                               WidthRequest="100" 
                               CornerRadius="50"
                               HorizontalOptions="Center"
                               BackgroundColor="#F0F0F0"
                               Padding="0">
                            <Image Source="{Binding ProfileImage}"
                                   Aspect="AspectFill"
                                   HeightRequest="100"
                                   WidthRequest="100">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickImageCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Frame>

                        <Label Text="📷 Натиснете за да добавите снимка"
                               HorizontalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource PrimaryColor}"
                               FontAttributes="Bold"
                               Margin="0,5">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickImageCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Име поле -->
                        <Label Text="Име"
                               TextColor="{StaticResource DarkColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,5,0,0"/>
                        <Entry Placeholder="Вашето име"
                               Text="{Binding Name}"
                               ReturnType="Next"/>

                        <!-- Телефон поле -->
                        <Label Text="Телефон"
                               TextColor="{StaticResource DarkColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,5,0,0"/>
                        <Entry Placeholder="0888 123 456"
                               Text="{Binding PhoneNumber}"
                               Keyboard="Telephone"
                               ReturnType="Next"/>

                        <!-- Адрес поле с бутон за локация -->
                        <Label Text="Адрес"
                               TextColor="{StaticResource DarkColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,5,0,0"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Editor Grid.Column="0"
                                    Placeholder="Вашият адрес"
                                    Text="{Binding Address}"
                                    AutoSize="TextChanges"
                                    HeightRequest="80"
                                    Margin="0,0,10,0"/>

                            <Button Grid.Column="1"
                                    Text="📍"
                                    Command="{Binding UseCurrentLocationCommand}"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    TextColor="White"
                                    FontSize="24"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    CornerRadius="25"
                                    VerticalOptions="Start"/>
                        </Grid>

                        <!-- Локация пояснение -->
                        <HorizontalStackLayout Spacing="5" 
                                               HorizontalOptions="Center"
                                               Margin="0,5,0,0">
                            <Label Text="📍"
                                   FontSize="12"
                                   TextColor="{StaticResource PrimaryColor}"/>
                            <Label Text="Натиснете бутона за да използвате текущата ви локация"
                                   FontSize="10"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Error message -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource PrimaryColor}"
                               FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                               HorizontalOptions="Center"
                               Margin="0,10"/>

                        <!-- Save бутон -->
                        <Button Text="ЗАПАЗИ"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="25"
                                HeightRequest="50"
                                Margin="0,10,0,0"/>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource PrimaryColor}"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>