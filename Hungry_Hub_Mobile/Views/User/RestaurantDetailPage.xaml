<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.User.RestaurantDetailPage"
             xmlns:viewModels="clr-namespace:Hungry_Hub_Mobile.ViewModels.User"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Горна лента -->
        <Grid Grid.Row="0" Padding="15,10" BackgroundColor="#2196F3"
      ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0" 
            Text="← Назад" 
            Command="{Binding GoBackCommand}"
            BackgroundColor="Transparent" 
            TextColor="White" 
            FontSize="16"
            Padding="0"
            HorizontalOptions="Start"/>

            <Label Grid.Column="1" 
           Text="{Binding Restaurant.name}"
           FontSize="18" 
           FontAttributes="Bold" 
           TextColor="White"
           HorizontalOptions="Center" 
           VerticalOptions="Center"
           LineBreakMode="TailTruncation"/>

            <Button Grid.Column="2" 
            Text="Изход" 
            Command="{Binding LogoutCommand}"
            BackgroundColor="Transparent" 
            TextColor="White" 
            FontSize="14"
            Padding="5,0"/>

        </Grid>

        <!-- Списък -->
        <!-- Списък (опростен вариант без конвертор) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Articles}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5" Padding="10" CornerRadius="10" BorderColor="LightGray" BackgroundColor="White">
                        <Grid ColumnDefinitions="80,*,Auto" RowDefinitions="Auto,Auto,Auto">

                            <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                           Source="{Binding Img}" WidthRequest="70" HeightRequest="70" Aspect="AspectFill"/>

                            <Label Grid.Row="0" Grid.Column="1" 
                           Text="{Binding Name}" FontSize="14" FontAttributes="Bold" 
                           TextColor="#333333"/>

                            <!-- Съставки (показва се само ако има) -->
                            <Label Grid.Row="1" Grid.Column="1" 
                           Text="{Binding Ingredients}" FontSize="11" TextColor="#666666"
                           MaxLines="2" LineBreakMode="WordWrap" Margin="0,3,0,3"/>

                            <!-- Грамаж и цена на един ред -->
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="15">
                                <Label Text="{Binding Weight, StringFormat='{0} г'}" 
                               FontSize="11" TextColor="#999999"/>
                                <Label Text="{Binding Price, StringFormat='{0:F2} лв'}" 
                               FontSize="14" FontAttributes="Bold" TextColor="#2196F3"/>
                            </HorizontalStackLayout>

                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                            Text="➕" BackgroundColor="#4CAF50" TextColor="White"
                            FontSize="18" CornerRadius="25" WidthRequest="45" HeightRequest="45"
                            VerticalOptions="Center"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:RestaurantDetailViewModel}}, Path=AddToCartCommand}"
                            CommandParameter="{Binding .}"/>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- Долна навигация -->
        <Grid Grid.Row="2" BackgroundColor="#2196F3" Padding="0,8" ColumnDefinitions="*,*,*,*">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                <Label Text="🏠" FontSize="22"/>
                <Label Text="Начало" FontSize="11" TextColor="White"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="🛒" FontSize="22"/>
                <Label Text="Количка" FontSize="11" TextColor="White"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCartCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                <Label Text="📦" FontSize="22"/>
                <Label Text="Поръчки" FontSize="11" TextColor="White"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrdersCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                <Label Text="👤" FontSize="22"/>
                <Label Text="Профил" FontSize="11" TextColor="White"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>