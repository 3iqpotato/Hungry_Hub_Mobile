<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.Orders.MyOrdersPage"
             xmlns:viewModels="clr-namespace:Hungry_Hub_Mobile.ViewModels.Orders"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             Title="Моите поръчки">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Горна лента -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="15"
                               Padding="15,10"
                               BackgroundColor="#2196F3">

            <Button Text="←"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="20"/>

            <Label Text="Моите поръчки" 
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"/>

            <Button Text="⟳"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="20"/>
        </HorizontalStackLayout>

        <!-- Списък с поръчки -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Orders}"
                        Margin="10">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10" 
                                     Padding="20"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="📦"
                           FontSize="48"
                           HorizontalOptions="Center"/>
                    <Label Text="Все още нямате поръчки"
                           FontSize="16"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Целият Frame е натискаем -->
                    <Frame Margin="0,5" 
                           Padding="15"
                           CornerRadius="10"
                           BorderColor="LightGray">

                        <!-- GestureRecognizers за натискане на целия Frame -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MyOrdersViewModel}}, Path=SelectOrderCommand}"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <!-- Горен ред: номер и статус -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Id, StringFormat='Поръчка #{0}'}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>

                                <Label Grid.Column="1"
                                       Text="{Binding StatusDisplayName}"
                                       TextColor="White"
                                       BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                       Padding="8,3"
                                       FontSize="12"
                                       FontAttributes="Bold"/>
                            </Grid>

                            <!-- Ресторант -->
                            <Label Text="{Binding RestaurantName}"
                                   FontSize="14"
                                   TextColor="#2196F3"/>

                            <!-- Дата и час -->
                            <Label Text="{Binding FormattedDateTime}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                            <!-- Брой артикули и сума на един ред -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding ItemsCount, StringFormat='Артикули: {0}'}"
                                       FontSize="12"/>

                                <Label Grid.Column="1" 
                                       Text="{Binding FormattedTotal}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#4CAF50"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Съобщение за грешка -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="20"/>
    </Grid>
</ContentPage>