<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.Orders.MyOrdersPage"
             xmlns:viewModels="clr-namespace:Hungry_Hub_Mobile.ViewModels.Orders"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Title="Моите поръчки">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:StatusColorConverter x:Key="StatusColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ГОРНА ЛЕНТА (като CartPage) -->
        <Grid Grid.Row="0" 
              Padding="15,10" 
              BackgroundColor="#2196F3"
              ColumnDefinitions="*,Auto">

            <Label Grid.Column="0" 
                   Text="Hungry Hub" 
                   FontSize="22"
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalOptions="Center"/>

            <Button Grid.Column="1" 
                    Text="Изход"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent" 
                    TextColor="White"
                    FontSize="14" 
                    Padding="5,0"/>

        </Grid>

        <!-- Списък с поръчки -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Orders}"
                        Margin="10"
                        VerticalOptions="FillAndExpand">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10" 
                                     Padding="20"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="📦"
                           FontSize="64"
                           HorizontalOptions="Center"/>
                    <Label Text="Все още нямате поръчки"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Направете първата си поръчка"
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Button Text="Към ресторантите"
                            Command="{Binding GoToHomeCommand}"
                            BackgroundColor="#2196F3" 
                            TextColor="White" 
                            Margin="0,20,0,0"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" 
                           Padding="15"
                           CornerRadius="10"
                           BorderColor="LightGray"
                           BackgroundColor="White">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MyOrdersViewModel}}, Path=SelectOrderCommand}"
                                CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <!-- Горен ред: номер и статус -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding Id, StringFormat='Поръчка #{0}'}"
                                       FontAttributes="Bold"
                                       FontSize="16"/>

                                <Label Grid.Column="1"
                                       Text="{Binding StatusDisplayName}"
                                       TextColor="White"
                                       BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                       Padding="8,3"
                                       FontSize="12"
                                       FontAttributes="Bold"></Label>
                            </Grid>

                            <!-- Ресторант -->
                            <Label Text="{Binding RestaurantName}"
                                   FontSize="14"
                                   TextColor="#2196F3"
                                   FontAttributes="Bold"/>

                            <!-- Дата и час -->
                            <Label Text="{Binding FormattedDateTime}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                            <!-- Брой артикули и сума на един ред -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding ItemsCount, StringFormat='📦 Артикули: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray"/>

                                <Label Grid.Column="1" 
                                       Text="{Binding FormattedTotal}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#4CAF50"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Съобщение за грешка / зареждане -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" 
                               Color="#2196F3"/>
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   Margin="20"/>
        </Grid>

        <!-- ДОЛНА НАВИГАЦИЯ (като CartPage) -->
        <Grid Grid.Row="2" 
              BackgroundColor="#2196F3" 
              Padding="0,8"
              ColumnDefinitions="*,*,*,*">

            <!-- Начало -->
            <VerticalStackLayout Grid.Column="0" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="🏠" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Начало" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToHomeCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Количка -->
            <VerticalStackLayout Grid.Column="1" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="🛒" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Количка" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCartCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Поръчки (активна) -->
            <VerticalStackLayout Grid.Column="2" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="📦" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Поръчки" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToOrdersCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Профил -->
            <VerticalStackLayout Grid.Column="3" 
                                 Spacing="2" 
                                 HorizontalOptions="Center">
                <Label Text="👤" FontSize="22" HorizontalOptions="Center"/>
                <Label Text="Профил" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}"/>
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

        </Grid>

    </Grid>
</ContentPage>