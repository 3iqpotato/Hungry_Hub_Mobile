<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.Orders.CheckoutPage"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Title="Потвърждение">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Горна лента -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="15"
                               Padding="15,10"
                               BackgroundColor="#2196F3">

            <Button Text="←"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="20"/>

            <Label Text="Потвърждение на поръчката" 
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Детайли на поръчката -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15" Padding="20">

                <!-- Адрес за доставка -->
                <Frame CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Адрес за доставка"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Text="{Binding UserAddress, FallbackValue='Зареждане...'}"
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Артикули -->
                <Label Text="Артикули"
                       FontAttributes="Bold"
                       FontSize="16"
                       Margin="0,5,0,5"/>

                <CollectionView ItemsSource="{Binding Cart.Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,2" Padding="10" CornerRadius="5">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding ArticleName}"
                                           FontSize="14"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Quantity, StringFormat='x{0}'}"
                                           TextColor="Gray"
                                           Margin="10,0"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding TotalPriceDecimal, StringFormat='{}{0:F2} лв'}"
                                           FontAttributes="Bold"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Суми -->
                <Frame CornerRadius="10" Padding="15" Margin="0,10">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Междинна сума:"/>
                            <Label Grid.Column="1" Text="{Binding FormattedSubtotal}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding HasDeliveryFee}">
                            <Label Grid.Column="0" Text="Такса доставка:"/>
                            <Label Grid.Column="1" Text="{Binding FormattedDeliveryFee}"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="LightGray"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" 
                                   Text="ОБЩО:" 
                                   FontAttributes="Bold"/>
                            <Label Grid.Column="1" 
                                   Text="{Binding FormattedTotal}" 
                                   FontAttributes="Bold"
                                   TextColor="#4CAF50"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Предупреждение за празна количка -->
                <Label Text="Количката е празна"
                       TextColor="Red"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsCartEmpty}"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Долен бутон -->
        <VerticalStackLayout Grid.Row="2"
                            Spacing="10"
                            Padding="20">
            <Button Text="Потвърди поръчка"
                    Command="{Binding PlaceOrderCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#4CAF50"
                    IsVisible="{Binding IsCartEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>

            <ActivityIndicator IsRunning="{Binding IsProcessing}"
                              IsVisible="{Binding IsProcessing}"/>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>