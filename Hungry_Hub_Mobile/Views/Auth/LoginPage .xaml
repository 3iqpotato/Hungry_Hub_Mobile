<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hungry_Hub_Mobile.Views.Auth.LoginPage"
             xmlns:converters="clr-namespace:Hungry_Hub_Mobile.Converters"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource BackgroundGradient}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

                <!-- Хедър с бутон за назад - по-голям и по-наляво -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Бутон за назад - по-голям и по-видим -->
                    <Button Grid.Column="0"
                            Text="←"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="32"
                            FontAttributes="Bold"
                            WidthRequest="60"
                            HeightRequest="60"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="-10,-10,0,0"/>

                    <Label Grid.Column="1"
                           Text=""
                           HorizontalOptions="Center"/>
                </Grid>

                <!-- Лого - временно текстово, докато оправиш PNG -->
                <Frame HeightRequest="100" 
                       WidthRequest="100" 
                       CornerRadius="50"
                       HorizontalOptions="Center"
                       BackgroundColor="White"
                       Padding="20"
                       Margin="0,0,0,20">
                    <Label Text="🍔"
                           FontSize="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <Label Text="Добре дошли отново!"
                       Style="{StaticResource TitleLabel}"
                       FontSize="28"/>

                <Label Text="Влезте в своя профил"
                       Style="{StaticResource SubtitleLabel}"/>

                <!-- Форма за вход -->
                <Frame CornerRadius="20"
                       BackgroundColor="White"
                       Padding="20"
                       Margin="0,20">
                    <VerticalStackLayout Spacing="15">

                        <Label Text="Имейл"
                               TextColor="#2D2D2D"
                               FontSize="14"
                               FontAttributes="Bold"/>

                        <Entry Placeholder="your@email.com"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               ReturnType="Next"/>

                        <Label Text="Парола"
                               TextColor="#2D2D2D"
                               FontSize="14"
                               FontAttributes="Bold"
                               Margin="0,10,0,0"/>

                        <Entry Placeholder="••••••••"
                               Text="{Binding Password}"
                               IsPassword="True"
                               ReturnType="Done"/>

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#FF6B35"
                               FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                               HorizontalOptions="Center"
                               Margin="0,5"/>

                        <Button Text="ВХОД"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="#FF6B35"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                CornerRadius="25"
                                HeightRequest="50"
                                Margin="0,20,0,0"/>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#FF6B35"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Линк за регистрация -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Нямате профил?"
                           TextColor="White"
                           Opacity="0.9"/>
                    <Label Text="Регистрирайте се"
                           TextColor="White"
                           FontAttributes="Bold"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>